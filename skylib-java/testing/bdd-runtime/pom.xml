<?xml version="1.0"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<modelVersion>4.1.0</modelVersion>
	<parent/>
	<artifactId>lib-testing-bdd-runtime</artifactId>
	<dependencies>

		<!-- http server -->
		<dependency>
			<groupId>ch.scaille</groupId>
			<artifactId>lib-testing-selenium-test-page</artifactId>
			<version>${revision}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- MAVEN4 HACK -->
					<additionalClasspathDependencies>        <dependency>
						<groupId>io.undertow</groupId>
						<artifactId>undertow-core</artifactId>
						<version>${undertow.version}</version>
					</dependency>
					</additionalClasspathDependencies>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>