        <zeebe:script expression="={&#10;  buildTestApiParam: function(prefix, apiId, p, mappings)&#10;    {&#10;      id: prefix + &#34;-&#34; + businessKey,&#10;      tcDataType: &#34;TestParameterValue&#34;,&#10;      apiParameterId: apiId,&#10;      testParameterFactoryRef: p.factory,&#10;      complexTypeValues:&#10;        if p.values = null then {}&#10;        else context(&#10;          for e in get entries(p.values) return {&#10;            key: get value(mappings, e.key),&#10;            value: {&#10;              id: get value(mappings, e.key),&#10;              tcDataType: &#34;TestParameterValue&#34;,&#10;              apiParameterId: get value(mappings, e.key),&#10;              testParameterFactoryRef: get value(mappings, get value(mappings, e.key)),&#10;              simpleValue: string(e.value),&#10;              complexTypeValues: {}&#10;            }&#10;          }&#10;&#10;        )&#10;    },&#10;    buildSimpleParam: function(prefix, apiId, p, mappings)&#10;        {&#10;          id: prefix + &#34; &#34; + businessKey,&#10;          tcDataType: &#34;TestParameterValue&#34;,&#10;          apiParameterId: apiId,&#10;          simpleValue: string(p.value)&#10;        },&#10;#if( $param0 )&#10;   param0mappings: {&#10;#foreach( $parameterMappingName in ${param0.parameterMappings.keySet()} )&#34;${parameterMappingName}&#34;: &#34;${param0.parameterMappings.get($parameterMappingName)}&#34;#if($foreach.hasNext),#end&#10;#end&#10;    },#end&#10;#if( $param1 )&#10;   param1mappings: {&#10;#foreach( $parameterMappingName in ${param1.parameterMappings.keySet()} )&#34;${parameterMappingName}&#34;: &#34;${param1.parameterMappings.get($parameterMappingName)}&#34;#if($foreach.hasNext),#end&#10;#end&#10;    },#end&#10;result: {&#10;    roleRef: &#34;${action.role}&#34;,&#10;    actorRef: &#34;$step.get('actor').asText()&#34;,&#10;    actionRef: &#34;${action.action}&#34;,&#10;    classifier: &#34;PREPARATION&#34;,&#10;    ordinal: count(testCaseSteps) + 1,&#10;    parametersValue: [#if( $param0 )#if ( ${param0.nature} == 'SimpleType' )      buildSimpleParam(&#34;param0&#34;, &#34;${param0.testApiParameter}&#34;, param0, param0mappings)#else&#10;      buildTestApiParam(&#34;param0&#34;, &#34;${param0.testApiParameter}&#34;, param0, param0mappings)#end#end #if( $param0 && $param1 ),#end #if( $param1 )#if ( ${param1.nature} == 'SimpleType' )&#10;      buildSimpleParam(&#34;param1&#34;, &#34;${param1.testApiParameter}&#34;, param1, param1mappings),&#10;    #else&#10;      buildTestApiParam(&#34;param1&#34;, &#34;${param1.testApiParameter}&#34;, param1, param1mappings)&#10;#end#end]&#10;  }&#10;}.result"
