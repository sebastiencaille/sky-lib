      <bpmn:script><![CDATA[
var params = [];

/**
 * Builds a TestParameterValue and its nested complex values.
 * @param {string} index        parameter index (used in the id)
 * @param {string} apiParamId   apiParameterId of the top-level parameter
 * @param {object} param        input node (has "factory" and "values")
 * @param {object} mappings     key -> id / id -> type mappings
 */
function buildTestApiParam(index, apiParamId, param, mappings) {
    var tcwParam = {
        id: 'param' + index + '-' + businessKey,
        tcDataType: 'TestParameterValue',
        apiParameterId: apiParamId,
        testParameterFactoryRef: param.get('factory').asText(),
        complexTypeValues: {}
    };

    var values = param.get('values');
    if (values) {
        values.properties().forEach(function (prop) {
            var paramId = mappings[prop.getKey()];
            tcwParam.complexTypeValues[paramId] = {
                id: paramId,
                tcDataType: 'TestParameterValue',
                apiParameterId: paramId,
                testParameterFactoryRef: mappings[paramId], // the type
                simpleValue: prop.getValue().asText(),
                complexTypeValues: {}
            };
        });
    }
    return tcwParam;
}

/**
 * Builds a TestParameterValue and its nested complex values.
 * @param {string} index        parameter index (used in the id)
 * @param {string} apiParamId   apiParameterId of the top-level parameter
 * @param {object} param        input node (has "factory" and "values")
 * @param {object} mappings     key -> id / id -> type mappings
 */
function buildSimpleParam(index, apiParamId, param, mappings) {
    var tcwParam = {
        id: 'param' + index + '-' + businessKey,
        tcDataType: 'TestParameterValue',
        simpleValue: param.getValue().asText(),
        apiParameterId: apiParamId,
        testParameterFactoryRef: param.get('factory').asText(),
        complexTypeValues: {}
    };
    return tcwParam;
}

#if( $param0 )
var param0mappings = [];
#foreach( $parameterMappingName in ${param0.parameterMappings.keySet()} )
param0mappings['${parameterMappingName}'] = '${param0.parameterMappings.get($parameterMappingName)}';
#end

#if ( ${param0.nature} == 'SimpleType' )
params.push(buildSimpleParam(0, '${param0.testApiParameter}', param0, param0mappings));
#else
params.push(buildTestApiParam(0, '${param0.testApiParameter}', param0, param0mappings));
#end

#end## if( $param0 )

#if( $param1 )
var param1mappings = [];
#foreach( $parameterMappingName in ${param1.parameterMappings.keySet()} )
param1mappings['${parameterMappingName}'] = '${param1.parameterMappings.get($parameterMappingName)}';
#end

#if ( ${param1.nature} == 'SimpleType' )
params.push(buildSimpleParam(1, '${param1.testApiParameter}', param1, param0mappings));
#else
params.push(buildTestApiParam(1, '${param1.testApiParameter}', param1, param0mappings));
#end
#end## if( $param1 )

var consolidatedStep = {
	roleRef: '${action.role}',
    actorRef: step.get('actor').asText(),
	actionRef: '${action.action}',
	classifier: 'PREPARATION',
	ordinal: testCaseSteps.size() + 1,
    parametersValue: params,
};

flw.json.stringToJson(JSON.stringify(consolidatedStep))

]]></bpmn:script>
