<project xmlns="http://maven.apache.org/POM/4.1.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
	<modelVersion>4.1.0</modelVersion>
	<parent/>
	<artifactId>testcase-writer-webapp-ide-runner</artifactId>

	<dependencies>
		<dependency>
			<groupId>ch.scaille.tcwriter</groupId>
			<artifactId>testcase-writer-webapp-api-v0-backend</artifactId>
		</dependency>

		<dependency>
			<groupId>ch.scaille.tcwriter</groupId>
			<artifactId>testcase-writer-examples</artifactId>
			<version>${revision}</version>
			<classifier>client-bundle</classifier>
			<type>zip</type>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>ch.scaille.tcwriter</groupId>
			<artifactId>testcase-writer-javatc-core</artifactId>
			<classifier>client-bundle</classifier>
			<type>zip</type>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>ch.scaille.tcwriter</groupId>
			<artifactId>testcase-writer-webapp-testing</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<executions>
					<execution>
						<id>tc-resources</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>single</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<formats>
						<format>dir</format>
					</formats>
					<finalName>classes</finalName>
					<descriptors>
						<descriptor>../war/src/assembly/tc-resources.xml</descriptor>
					</descriptors>
					<inlineDescriptors>
						<inlineDescriptor>
							<id>example</id>
							<formats>
								<format>dir</format>
							</formats>
							<includeBaseDirectory>false</includeBaseDirectory>
							<dependencySets>
								<dependencySet>
									<scope>provided</scope>
									<outputDirectory>example_resources</outputDirectory>
									<includes>
										<include>
											ch.scaille.tcwriter:testcase-writer-examples:zip:client-bundle</include>
									</includes>
									<unpack>true</unpack>
								</dependencySet>
							</dependencySets>
						</inlineDescriptor>
					</inlineDescriptors>
				</configuration>

			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<jvmArguments>
						--add-reads
						org.hibernate.validator=org.apache.tomcat.embed.el
						--add-opens=java.base/java.lang=spring.core
					</jvmArguments>
					<mainClass>ch.scaille.tcwriter.idelauncher.Server</mainClass>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>